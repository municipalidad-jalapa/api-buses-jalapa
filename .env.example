# Variables de entorno del backend de EcoRuta.
#
# Copiar a .env para desarrollo local. .env esta en .gitignore y NUNCA se sube.
# En QA y produccion los valores viven como variables de CI/CD de GitLab con
# Protect y Mask, y environment scope qa o production (HU-23, SCRUM-118).
#
# Los valores de este archivo son de EJEMPLO. Ninguno sirve en produccion.

# ---------------------------------------------------------------------------
# Base de datos (PostgreSQL 17 + PostGIS)
# ---------------------------------------------------------------------------
# Obligatorias en QA y produccion. En local tienen valores por defecto que
# calzan con docker-compose.yml, asi que se pueden omitir.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ecoruta
DB_USER=ecoruta
DB_PASSWORD=cambiar

# ---------------------------------------------------------------------------
# Acceso de administracion  --  PROVISIONAL, se retira con SCRUM-134
# ---------------------------------------------------------------------------
# Concede ROLE_ADMIN a quien presente este valor en la cabecera X-Admin-Token.
# Existe solo mientras la autenticacion de personas con Firebase (SCRUM-134) no
# este construida; los endpoints /api/v1/admin/** ya exigen hasRole('ADMIN') de
# forma normal y no cambiaran cuando se retire.
#
# Minimo 32 caracteres: con menos, la aplicacion NO ARRANCA.
#
# IMPORTANTE PARA DESPLIEGUE: si esta variable no se define, nadie obtiene
# ROLE_ADMIN y /api/v1/admin/** rechaza a todos. Eso es correcto en produccion
# --falla cerrado-- pero en QA significa que no se puede dar de alta ningun
# equipo a bordo, y sin equipo no se puede ingestar una sola posicion.
#
# Llega con SCRUM-142.
ECORUTA_ADMIN_TOKEN=solo-para-desarrollo-local-cambiar-en-produccion

# ---------------------------------------------------------------------------
# CORS  --  lo llena SCRUM-274
# ---------------------------------------------------------------------------
# Origenes exactos separados por coma, de donde se sirve la aplicacion web.
# Vacio (por defecto) = ningun origen permitido.
#   qa:         https://qa.buses.jalapa.gob.gt
#   produccion: https://buses.jalapa.gob.gt
CORS_ORIGENES=https://qa.buses.jalapa.gob.gt,https://buses.jalapa.gob.gt

# ---------------------------------------------------------------------------
# Firma del JWT propio del backend  --  HU-Desarrollo-63
# ---------------------------------------------------------------------------
# Firma el JWT de jornada del conductor (no es el idToken de Firebase).
# Minimo 32 caracteres. Duracion por defecto: 480 minutos (8 h).
JWT_SECRET=cambiar-en-produccion-minimo-32-caracteres
JWT_DURACION_MINUTOS=480

# ---------------------------------------------------------------------------
# Firebase Admin SDK  --  HU-Desarrollo-63
# ---------------------------------------------------------------------------
# Una de las dos credenciales basta. NUNCA se sube el JSON al repositorio
# (HU-23): en local va por FIREBASE_CREDENTIALS_PATH; en CI/CD como
# variable o Secure File.
# FIREBASE_PROJECT_ID=
# FIREBASE_CREDENTIALS_PATH=
# FIREBASE_CREDENTIALS_JSON=

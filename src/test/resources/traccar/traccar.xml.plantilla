<?xml version='1.0' encoding='UTF-8'?>
<!DOCTYPE properties SYSTEM 'http://java.sun.com/dtd/properties.dtd'>
<properties>

    <entry key='database.driver'>org.h2.Driver</entry>
    <entry key='database.url'>jdbc:h2:./data/database</entry>
    <entry key='database.user'>sa</entry>
    <entry key='database.password'></entry>

    <!-- Sin esto Traccar ignora el IMEI del emisor y no hay posicion. -->
    <entry key='database.registerUnknown'>true</entry>

    <!-- Traccar 6.15.3: forward.enable y forward.json ya no existen.
         El reenvio se activa con forward.url. El tipo por defecto (url)
         manda GET con placeholders; el adaptador espera POST JSON. -->
    <entry key='forward.type'>json</entry>
    <entry key='forward.url'>__FORWARD_URL__</entry>
    <entry key='forward.header'>X-Traccar-Token: __TRACCAR_TOKEN__</entry>
    <entry key='forward.retry.enable'>true</entry>
    <entry key='forward.retry.delay'>500</entry>
    <entry key='forward.retry.count'>10</entry>
    <entry key='forward.retry.limit'>100</entry>

    <!-- Apagado a proposito: si filter.past filtrara una fecha vieja,
         el criterio 6 no llegaria al adaptador. -->
    <entry key='filter.enable'>false</entry>

    <entry key='logger.console'>true</entry>
    <entry key='gps103.port'>5001</entry>
    <entry key='tk103.port'>5002</entry>

</properties>
